# =============================================
# Maven / Java Build Artifacts
# =============================================
target/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar

# Maven wrapper (keep .mvn/wrapper/maven-wrapper.properties)
!.mvn/wrapper/maven-wrapper.jar

# =============================================
# Environment / Secrets — NEVER COMMIT THESE
# =============================================
.env
.env.*
!.env.example
*.secret
*.key
*.pem
*.p12
*.jks
*.pfx

# =============================================
# Spring Boot Local Overrides
# Keep: application.yml, application-dev.yml, application-prod.yml
# (they must contain only safe placeholders / env-var references)
# =============================================
application-local.yml
application-local.properties

# =============================================
# Logs
# =============================================
*.log
logs/
spring.log

# =============================================
# IDE — IntelliJ IDEA
# =============================================
.idea/
*.iml
*.iws
*.ipr
out/

# IDE — VS Code
.vscode/

# IDE — Eclipse / STS
.classpath
.project
.settings/
*.launch

# IDE — NetBeans
nbproject/
nbbuild/
nbdist/

# =============================================
# OS Generated Files
# =============================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# =============================================
# Temporary / Swap Files
# =============================================
*.tmp
*.temp
*.swp
*.swo
*~
